[Unit]
Description=DarkEyes Greeter (optional admin password, Tails-style)
# Run before the graphical login so admin state is decided first.
After=systemd-user-sessions.service plymouth-quit-wait.service
Before=display-manager.service gdm.service
Conflicts=getty@tty1.service
ConditionPathExists=/usr/local/bin/darkeyes-greeter

[Service]
Type=oneshot
RemainAfterExit=yes
# Own tty1 for the whiptail dialog; drop the boot splash first.
ExecStartPre=-/usr/bin/plymouth quit --retain-splash
ExecStart=/usr/local/bin/darkeyes-greeter
StandardInput=tty-force
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
# Never hang the whole boot forever if something goes wrong.
TimeoutStartSec=300

[Install]
WantedBy=graphical.target
