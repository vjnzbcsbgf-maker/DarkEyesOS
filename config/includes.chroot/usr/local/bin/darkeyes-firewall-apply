#!/bin/sh
# darkeyes-firewall-apply — render the nftables ruleset with the real debian-tor
# uid substituted in, so the Tor daemon (and only it) can reach the network.
set -eu

SRC=/etc/nftables.conf
DST=/run/darkeyes/nftables.active

mkdir -p /run/darkeyes

# Pin DNS to Tor's DNSPort (via the firewall redirect). Done at boot rather than
# build time so it never interferes with live-build's chroot teardown. If
# resolv.conf is a symlink (e.g. to systemd-resolved), replace it with a real file.
darkeyes_pin_resolv() {
    if [ -L /etc/resolv.conf ]; then rm -f /etc/resolv.conf; fi
    cat > /etc/resolv.conf <<'RESOLV'
# DarkEyesOS: DNS is served by Tor's DNSPort via the firewall redirect.
nameserver 127.0.0.1
options edns0
RESOLV
}
darkeyes_pin_resolv 2>/dev/null || true

TOR_UID="$(id -u debian-tor 2>/dev/null || echo 0)"
if [ "$TOR_UID" = "0" ]; then
    echo "darkeyes-firewall: debian-tor user not found; refusing to open network" >&2
    # Load a total-drop ruleset rather than risk a leak.
    cat > "$DST" <<'EOF'
flush ruleset
table inet darkeyes {
    chain output { type filter hook output priority 0; policy drop; oif "lo" accept; }
    chain input  { type filter hook input  priority 0; policy drop; iif "lo" accept; }
}
EOF
    exit 0
fi

# Unsafe Browser (captive portal): allow the clearnet uid to bypass Tor ONLY
# while the enable flag exists. Off by default -> fully fail-closed Tor-only.
CLEARNET_NAT=""
CLEARNET_FILTER=""
if [ -f /run/darkeyes/unsafe-browser.enabled ]; then
    CN_UID="$(id -u clearnet 2>/dev/null || echo '')"
    if [ -n "$CN_UID" ]; then
        CLEARNET_NAT="meta skuid ${CN_UID} return"
        CLEARNET_FILTER="meta skuid ${CN_UID} accept"
        echo "darkeyes-firewall: clearnet (Unsafe Browser) exception ACTIVE for uid ${CN_UID}" >&2
    fi
fi

# I2P daemon (i2pd): allow its uid to reach the network too, so .i2p works
# alongside Tor. Still fail-closed — only tor + i2pd users may egress; user apps
# go through the Tor transproxy or the I2P proxies. If i2pd isn't present, this
# stays empty and the ruleset is Tor-only.
I2P_NAT=""
I2P_FILTER=""
I2P_UID="$(id -u i2pd 2>/dev/null || echo '')"
if [ -n "$I2P_UID" ]; then
    I2P_NAT="meta skuid ${I2P_UID} return"
    I2P_FILTER="meta skuid ${I2P_UID} accept"
fi

# Replace the placeholder tor_uid and the clearnet/i2p markers.
sed \
    -e "s/^define tor_uid = .*/define tor_uid = ${TOR_UID}/" \
    -e "s|# @CLEARNET_NAT@.*|${CLEARNET_NAT}|" \
    -e "s|# @CLEARNET_FILTER@.*|${CLEARNET_FILTER}|" \
    -e "s|# @I2P_NAT@.*|${I2P_NAT}|" \
    -e "s|# @I2P_FILTER@.*|${I2P_FILTER}|" \
    "$SRC" > "$DST"
