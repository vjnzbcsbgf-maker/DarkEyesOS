# DarkEyesOS GNOME defaults: privacy-first, low-RAM, clean look.

[org/gnome/desktop/interface]
enable-animations=false
color-scheme='prefer-dark'
gtk-theme='Adwaita-dark'
icon-theme='Papirus-Dark'
cursor-theme='Bibata-Modern-Classic'
cursor-size=24
clock-show-weekday=true
font-antialiasing='grayscale'

[org/gnome/desktop/privacy]
remember-recent-files=false
remember-app-usage=false
report-technical-problems=false
send-software-usage-stats=false
disable-camera=false
old-files-age=uint32 0
recent-files-max-age=0

[org/gnome/desktop/search-providers]
disable-external=true

[org/gnome/desktop/session]
# Lock quickly when idle (amnesic + shoulder-surfing defense).
idle-delay=uint32 300

[org/gnome/desktop/screensaver]
lock-enabled=true
lock-delay=uint32 0

[org/gnome/desktop/media-handling]
automount=false
automount-open=false
autorun-never=true

[org/gnome/system/location]
enabled=false

[org/gnome/desktop/notifications]
show-in-lock-screen=false

[org/gnome/shell]
# Keep the shell lean: only our tools + essentials favorited.
favorite-apps=['torbrowser.desktop', 'darkeyes-control-center.desktop', 'org.gnome.Nautilus.desktop', 'org.gnome.Terminal.desktop', 'org.keepassxc.KeePassXC.desktop']

[org/gnome/mutter]
# Lower GPU/RAM pressure.
experimental-features=[]
