# DarkEyesOS GNOME defaults: privacy-first, low-RAM, clean look.

[org/gnome/desktop/interface]
enable-animations=false
color-scheme='prefer-dark'
gtk-theme='Adwaita-dark'
icon-theme='Papirus-Dark'
cursor-theme='Bibata-Modern-Classic'
cursor-size=24
clock-show-weekday=true
font-antialiasing='grayscale'

[org/gnome/desktop/privacy]
remember-recent-files=false
remember-app-usage=false
report-technical-problems=false
send-software-usage-stats=false
disable-camera=false
old-files-age=uint32 0
recent-files-max-age=0

[org/gnome/desktop/search-providers]
disable-external=true

[org/gnome/desktop/lockdown]
# Remove the lock-screen option entirely for the passwordless live user.
disable-lock-screen=true
disable-log-out=false

[org/gnome/desktop/session]
# NEVER auto-lock: the live user auto-logs in with NO password, so a lock screen
# would be impossible to unlock (blank password is rejected) -> total lockout.
# This was the v2.1 login bug. Amnesia comes from powering off (RAM wiped), not
# from a screen lock. Users who set an admin password can still lock manually.
idle-delay=uint32 0

[org/gnome/desktop/screensaver]
lock-enabled=false
idle-activation-enabled=false
lock-delay=uint32 0

[org/gnome/desktop/media-handling]
automount=false
automount-open=false
autorun-never=true

[org/gnome/system/location]
enabled=false

[org/gnome/desktop/notifications]
show-in-lock-screen=false

[org/gnome/shell]
# Keep the shell lean: our tools + the two browsers + Dolphin.
favorite-apps=['torbrowser.desktop', 'darkeyes-i2p-browser.desktop', 'darkeyes-control-center.desktop', 'org.kde.dolphin.desktop', 'org.gnome.Terminal.desktop', 'org.keepassxc.KeePassXC.desktop']

[org/gnome/mutter]
# Lower GPU/RAM pressure.
experimental-features=[]
