#!/bin/sh
# 0200-tor-transparent-proxy — force ALL traffic through Tor, fail-closed.
set -eu
echo "[darkeyes] 0200 Tor transparent proxy + fail-closed firewall"

# Dedicated system user id for Tor is provided by the debian tor package (debian-tor).
# We route everything except Tor's own uid through Tor, and DROP the rest.

# --- Enable tor + i2pd + our firewall at boot -----------------------------------
systemctl enable tor.service 2>/dev/null || true
systemctl enable darkeyes-firewall.service 2>/dev/null || true
# I2P daemon (dual-network). .i2p eepsites via its HTTP proxy 127.0.0.1:4444.
systemctl enable i2pd.service 2>/dev/null || true

# --- Disable clearnet DNS resolvers ---------------------------------------------
# All DNS must go through Tor's DNSPort (see /etc/tor/torrc + firewall redirect).
# NOTE: we do NOT write or chattr +i /etc/resolv.conf here. live-build manages
# /etc/resolv.conf during the build and restores it at chroot teardown; a build-
# time immutable bit makes that restore fail ("mv: Operation not permitted") and
# aborts the whole build. Instead, resolv.conf is pinned to 127.0.0.1 at BOOT by
# darkeyes-firewall.service (see darkeyes-firewall-apply), and NetworkManager is
# told not to touch it (dns=none in 00-darkeyes-mac.conf).
systemctl disable systemd-resolved.service 2>/dev/null || true

# --- Make sure IPv6 is disabled by default (avoids Tor-bypass leaks) ------------
mkdir -p /etc/sysctl.d
cat > /etc/sysctl.d/98-darkeyes-noipv6.conf <<'EOF'
# DarkEyesOS: disable IPv6 to prevent traffic bypassing the Tor IPv4 transproxy.
net.ipv6.conf.all.disable_ipv6 = 1
net.ipv6.conf.default.disable_ipv6 = 1
net.ipv6.conf.lo.disable_ipv6 = 1
EOF

echo "[darkeyes] 0200 done"
