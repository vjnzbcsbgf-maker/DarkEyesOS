#!/bin/sh
# 0800-users-branding — live user, locked root, admin-opt-in, and OS branding.
set -eu
echo "[darkeyes] 0800 users + branding"

# --- The live user 'amnesia' (created by live-config) has NO admin rights by
#     default. An admin password is only set at boot if the user opts in
#     (Tails model). Root account stays locked. -----------------------------------
passwd -l root 2>/dev/null || true

# --- Dedicated 'clearnet' user for the Unsafe Browser (captive portals). Its
#     traffic bypasses Tor ONLY when the Unsafe Browser is explicitly launched
#     (firewall flag). No login, no shell. -----------------------------------------
if ! id -u clearnet >/dev/null 2>&1; then
    useradd --system --home-dir /nonexistent --no-create-home \
        --shell /usr/sbin/nologin clearnet 2>/dev/null || true
fi

# live-config username/hostname
mkdir -p /etc/live/config.conf.d
cat > /etc/live/config.conf.d/darkeyes.conf <<'EOF'
LIVE_USERNAME="amnesia"
LIVE_USER_FULLNAME="DarkEyes Live User"
LIVE_HOSTNAME="darkeyes"
# Do NOT auto-grant sudo; admin access is opt-in at boot.
LIVE_USER_DEFAULT_GROUPS="audio cdrom dip video plugdev netdev bluetooth"
EOF

# sudo requires a password and is only usable if the DarkEyes Greeter set an
# admin password at boot (which also adds amnesia to the sudo group). The
# %sudo rule is Debian's default; we only tighten defaults here.
mkdir -p /etc/sudoers.d
cat > /etc/sudoers.d/darkeyes <<'EOF'
# DarkEyesOS: amnesia may use sudo only after an admin password is set at boot.
Defaults        env_reset,timestamp_timeout=0
Defaults        lecture=never
EOF
chmod 0440 /etc/sudoers.d/darkeyes

# Admin password is set (optionally) from a SAFE desktop dialog after login
# (darkeyes-admin-setup), not a pre-boot console greeter — the old greeter could
# hang boot waiting for invisible keyboard input. amnesia may run the setter
# without a password via the sudoers rule shipped in includes.chroot.

# --- OS branding ----------------------------------------------------------------
cat > /etc/os-release <<'EOF'
PRETTY_NAME="DarkEyesOS 2.2 (Tails-based · amnesic · Tor + I2P)"
NAME="DarkEyesOS"
VERSION_ID="2.2"
VERSION="2.2 (Tails-based, Debian-live)"
ID=darkeyesos
ID_LIKE=debian
HOME_URL="https://example.invalid/darkeyesos"
SUPPORT_URL="https://example.invalid/darkeyesos/docs"
EOF
cp -f /etc/os-release /usr/lib/os-release 2>/dev/null || true

echo "DarkEyesOS" > /etc/hostname
cat > /etc/issue <<'EOF'

  DarkEyesOS — amnesic, RAM-loaded, Tor-forced.
  Nothing is saved unless you unlock persistence.

EOF

echo "[darkeyes] 0800 done"
