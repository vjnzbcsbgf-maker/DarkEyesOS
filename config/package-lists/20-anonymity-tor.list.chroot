# DarkEyesOS — anonymity layer: Tor, transparent proxy, and the official browser.

# Tor daemon (transparent proxy + DNSPort + isolated SocksPorts)
tor
tor-geoipdb
torsocks

# Official Tor Browser via signature-verifying launcher (NOT a custom fork —
# see docs/THREAT_MODEL.md). torbrowser-launcher fetches + verifies upstream.
torbrowser-launcher

# Bridges / pluggable transports for censored networks
obfs4proxy

# I2P network (i2pd = lean C++ daemon; lower RAM than the Java i2p). Provides an
# HTTP proxy (127.0.0.1:4444) and SOCKS proxy (127.0.0.1:4447) for .i2p eepsites.
i2pd

# I2P Browser = hardened Firefox ESR profile wired to the I2P HTTP proxy.
firefox-esr

# Onion services / anonymized tooling
onionshare

# DNS-over-Tor helper + firewall
nftables

# Time sync over Tor is implemented by darkeyes-timesync (torsocks + curl over
# Tor); no extra package needed. (tlsdate was removed from Debian.)
